  <springProfile name="!dev">
    <root level="INFO">
      <appender-ref ref="console"/>
      <appender-ref ref="async"/>
      <appender-ref ref="error"/>
<!--      <appender-ref ref="logstash"/>-->
      <appender-ref ref="grpc-log"/>
    </root>
  </springProfile>

  <springProfile name="dev">
    <root level="info">
      <appender-ref ref="console"/>
      <appender-ref ref="async"/>
      <appender-ref ref="error"/>
<!--      <appender-ref ref="logstash"/>-->
    </root>
  </springProfile>
